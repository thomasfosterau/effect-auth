{
  "name": "@effect-auth/workos",
  "version": "0.1.0",
  "description": "Effect-native bindings for the WorkOS Node SDK, exposing the entire WorkOS feature set (SSO, AuthKit/User Management, Directory Sync, Organizations, MFA, Audit Logs, FGA, Vault, Webhooks and more) as typed Effects.",
  "keywords": [
    "auth",
    "authentication",
    "directory-sync",
    "effect",
    "effect-auth",
    "mfa",
    "scim",
    "sso",
    "workos"
  ],
  "homepage": "https://github.com/thomasfosterau/effect-auth#readme",
  "bugs": {
    "url": "https://github.com/thomasfosterau/effect-auth/issues"
  },
  "license": "MIT",
  "author": "",
  "repository": {
    "type": "git",
    "url": "https://github.com/thomasfosterau/effect-auth.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vp test run",
    "typecheck": "tsc --noEmit && vp test --typecheck --run"
  },
  "dependencies": {
    "@workos-inc/node": "^10.2.0"
  },
  "devDependencies": {
    "effect": "4.0.0-beta.59"
  },
  "peerDependencies": {
    "effect": ">=4.0.0-beta.59"
  }
}
