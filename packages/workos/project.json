{
  "name": "effect-auth-workos",
  "projectType": "library",
  "root": "packages/workos",
  "sourceRoot": "packages/workos/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "cwd": "packages/workos",
        "command": "vp exec tsc"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/workos",
        "command": "vp test run"
      },
      "configurations": {
        "watch": {
          "command": "vp test watch"
        }
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/workos",
        "command": "vp exec tsc --noEmit && vp test --typecheck --run"
      }
    }
  }
}
