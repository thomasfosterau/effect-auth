{
  "name": "@thomasfosterau/effect-auth-better-auth",
  "version": "0.0.0",
  "private": true,
  "description": "BetterAuth as the backend for effect-auth's services: keep BetterAuth's runtime, tables and routes, and gain effect-auth's Effect services, authorization kernel and guards.",
  "keywords": [
    "auth",
    "better-auth",
    "effect",
    "effect-auth",
    "migration"
  ],
  "homepage": "https://github.com/thomasfosterau/effect-auth#readme",
  "bugs": {
    "url": "https://github.com/thomasfosterau/effect-auth/issues"
  },
  "license": "MIT",
  "author": "Thomas Foster <me@thomasfoster.au>",
  "repository": {
    "type": "git",
    "url": "https://github.com/thomasfosterau/effect-auth.git",
    "directory": "packages/better-auth"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "docs": "docgen"
  },
  "dependencies": {
    "@thomasfosterau/effect-auth": "workspace:^"
  },
  "devDependencies": {
    "@effect/docgen": "catalog:",
    "@thomasfosterau/effect-auth-sveltekit": "workspace:^",
    "@types/node": "catalog:",
    "better-auth": "catalog:",
    "effect": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  },
  "peerDependencies": {
    "better-auth": "catalog:better-auth-peers",
    "effect": "catalog:peers"
  },
  "engines": {
    "node": ">=22"
  }
}
