{
  "name": "@thomasfosterau/effect-auth-saml",
  "version": "0.2.0",
  "description": "SAML 2.0 service-provider verifier for effect-auth — signed-assertion validation, AuthnRequest generation and SP metadata over @node-saml/node-saml.",
  "keywords": [
    "auth",
    "effect",
    "effect-auth",
    "saml",
    "saml2",
    "sso"
  ],
  "homepage": "https://github.com/thomasfosterau/effect-auth#readme",
  "bugs": {
    "url": "https://github.com/thomasfosterau/effect-auth/issues"
  },
  "license": "MIT",
  "author": "Thomas Foster <me@thomasfoster.au>",
  "repository": {
    "type": "git",
    "url": "https://github.com/thomasfosterau/effect-auth.git",
    "directory": "packages/saml"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@node-saml/node-saml": "catalog:",
    "@thomasfosterau/effect-auth": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "effect": "catalog:",
    "typescript": "catalog:",
    "xml-crypto": "catalog:"
  },
  "peerDependencies": {
    "effect": "catalog:peers"
  },
  "engines": {
    "node": "^20.19.0 || ^22.18.0 || >=24.11.0"
  }
}
