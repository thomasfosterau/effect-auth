{
  "name": "@thomasfosterau/effect-auth-client",
  "version": "0.1.0",
  "description": "Browser client for effect-auth: a typed, dependency-free client over the auth HTTP contract with an observable session store.",
  "keywords": [
    "auth",
    "authentication",
    "client",
    "effect",
    "effect-auth"
  ],
  "homepage": "https://github.com/thomasfosterau/effect-auth#readme",
  "bugs": {
    "url": "https://github.com/thomasfosterau/effect-auth/issues"
  },
  "license": "MIT",
  "author": "Thomas Foster <me@thomasfoster.au>",
  "repository": {
    "type": "git",
    "url": "https://github.com/thomasfosterau/effect-auth.git",
    "directory": "packages/client"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE.md"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/fixture.d.ts",
      "import": "./dist/testing/fixture.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@thomasfosterau/effect-auth": "workspace:*"
  },
  "devDependencies": {
    "effect": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@thomasfosterau/effect-jsonapi": "catalog:peers",
    "effect": "catalog:peers"
  },
  "peerDependenciesMeta": {
    "@thomasfosterau/effect-jsonapi": {
      "optional": true
    }
  }
}
