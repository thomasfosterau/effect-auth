{
  "name": "@thomasfosterau/effect-auth-resend",
  "version": "0.1.0",
  "description": "Resend EmailSender adapter for effect-auth — plain fetch against Resend's REST API, no SDK.",
  "keywords": [
    "auth",
    "effect",
    "effect-auth",
    "email",
    "resend"
  ],
  "homepage": "https://github.com/thomasfosterau/effect-auth#readme",
  "bugs": {
    "url": "https://github.com/thomasfosterau/effect-auth/issues"
  },
  "license": "MIT",
  "author": "Thomas Foster <me@thomasfoster.au>",
  "repository": {
    "type": "git",
    "url": "https://github.com/thomasfosterau/effect-auth.git",
    "directory": "packages/resend"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "test": "vp test run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json && vp test --typecheck --run"
  },
  "dependencies": {
    "@thomasfosterau/effect-auth": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "effect": ">=4.0.0-rc.112"
  },
  "peerDependencies": {
    "effect": ">=4.0.0-rc.112"
  },
  "engines": {
    "node": "^20.19.0 || ^22.18.0 || >=24.11.0"
  }
}
