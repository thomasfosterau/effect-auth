{
  "name": "@thomasfosterau/effect-auth-alchemy",
  "version": "0.1.0",
  "description": "Alchemy v2 AuthSchema resource, and Cloudflare D1 and Postgres (Hyperdrive) storage wiring, for effect-auth.",
  "keywords": [
    "alchemy",
    "auth",
    "authentication",
    "cloudflare",
    "d1",
    "hyperdrive",
    "effect",
    "effect-auth",
    "iac",
    "infrastructure",
    "postgres",
    "schema",
    "sql",
    "sqlite"
  ],
  "homepage": "https://github.com/thomasfosterau/effect-auth#readme",
  "bugs": {
    "url": "https://github.com/thomasfosterau/effect-auth/issues"
  },
  "license": "MIT",
  "author": "Thomas Foster <me@thomasfoster.au>",
  "repository": {
    "type": "git",
    "url": "https://github.com/thomasfosterau/effect-auth.git",
    "directory": "packages/alchemy"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./postgres": {
      "types": "./dist/Postgres.d.ts",
      "import": "./dist/Postgres.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@thomasfosterau/effect-auth": "workspace:*",
    "@thomasfosterau/effect-auth-sql": "workspace:*"
  },
  "devDependencies": {
    "@effect/sql-pg": "catalog:",
    "@effect/sql-pglite": "catalog:",
    "@electric-sql/pglite": "catalog:",
    "@types/better-sqlite3": "catalog:",
    "@types/node": "catalog:",
    "alchemy": "catalog:",
    "better-sqlite3": "catalog:",
    "effect": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@effect/sql-pg": "catalog:alchemy-peers",
    "alchemy": "catalog:peers",
    "effect": "catalog:alchemy-peers"
  },
  "peerDependenciesMeta": {
    "@effect/sql-pg": {
      "optional": true
    }
  },
  "engines": {
    "node": "^20.19.0 || ^22.18.0 || >=24.11.0"
  }
}
