{
  "name": "@thomasfosterau/effect-auth",
  "version": "0.5.1",
  "description": "An experimental Auth library for Effect: the headless core, plus the HTTP tier, the browser client, SQL storage and SAML as opt-in subpaths.",
  "keywords": [
    "auth",
    "authentication",
    "authorization",
    "client",
    "effect",
    "saml",
    "session",
    "sql",
    "sso"
  ],
  "homepage": "https://github.com/thomasfosterau/effect-auth#readme",
  "bugs": {
    "url": "https://github.com/thomasfosterau/effect-auth/issues"
  },
  "license": "MIT",
  "author": "Thomas Foster <me@thomasfoster.au>",
  "repository": {
    "type": "git",
    "url": "https://github.com/thomasfosterau/effect-auth.git",
    "directory": "packages/effect-auth"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./ladder": {
      "types": "./dist/Ladder.d.ts",
      "import": "./dist/Ladder.js"
    },
    "./email": {
      "types": "./dist/email/index.d.ts",
      "import": "./dist/email/index.js"
    },
    "./http": {
      "types": "./dist/http/index.d.ts",
      "import": "./dist/http/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    },
    "./client/atoms": {
      "types": "./dist/client/SessionAtoms.d.ts",
      "import": "./dist/client/SessionAtoms.js"
    },
    "./client/testing": {
      "types": "./dist/client/testing/fixture.d.ts",
      "import": "./dist/client/testing/fixture.js"
    },
    "./oauth": {
      "types": "./dist/oauth/index.d.ts",
      "import": "./dist/oauth/index.js"
    },
    "./password": {
      "types": "./dist/password/index.d.ts",
      "import": "./dist/password/index.js"
    },
    "./plugins": {
      "types": "./dist/plugins/index.d.ts",
      "import": "./dist/plugins/index.js"
    },
    "./multifactor": {
      "types": "./dist/multifactor/index.d.ts",
      "import": "./dist/multifactor/index.js"
    },
    "./sql": {
      "types": "./dist/sql/index.d.ts",
      "import": "./dist/sql/index.js"
    },
    "./saml": {
      "types": "./dist/saml/index.d.ts",
      "import": "./dist/saml/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "docs": "docgen"
  },
  "devDependencies": {
    "@effect/sql-pglite": "catalog:",
    "@electric-sql/pglite": "catalog:",
    "@node-saml/node-saml": "catalog:",
    "@thomasfosterau/effect-jsonapi": "catalog:",
    "@types/better-sqlite3": "catalog:",
    "@types/node": "catalog:",
    "better-sqlite3": "catalog:",
    "effect": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "workerd": "catalog:",
    "xml-crypto": "catalog:"
  },
  "peerDependencies": {
    "@node-saml/node-saml": "catalog:peers",
    "@thomasfosterau/effect-jsonapi": "catalog:peers",
    "effect": "catalog:peers"
  },
  "peerDependenciesMeta": {
    "@node-saml/node-saml": {
      "optional": true
    },
    "@thomasfosterau/effect-jsonapi": {
      "optional": true
    }
  },
  "engines": {
    "node": "^20.19.0 || ^22.18.0 || >=24.11.0"
  }
}
