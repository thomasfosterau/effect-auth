{
  "name": "@thomasfosterau/effect-auth",
  "version": "0.1.0",
  "description": "An experimental Auth library for Effect.",
  "keywords": [
    "auth",
    "authentication",
    "authorization",
    "effect",
    "session"
  ],
  "homepage": "https://github.com/thomasfosterau/effect-auth#readme",
  "bugs": {
    "url": "https://github.com/thomasfosterau/effect-auth/issues"
  },
  "license": "MIT",
  "author": "Thomas Foster <me@thomasfoster.au>",
  "repository": {
    "type": "git",
    "url": "https://github.com/thomasfosterau/effect-auth.git",
    "directory": "packages/effect-auth"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./email": {
      "types": "./dist/email/index.d.ts",
      "import": "./dist/email/index.js"
    },
    "./http": {
      "types": "./dist/http/index.d.ts",
      "import": "./dist/http/index.js"
    },
    "./oauth": {
      "types": "./dist/oauth/index.d.ts",
      "import": "./dist/oauth/index.js"
    },
    "./password": {
      "types": "./dist/password/index.d.ts",
      "import": "./dist/password/index.js"
    },
    "./plugins": {
      "types": "./dist/plugins/index.d.ts",
      "import": "./dist/plugins/index.js"
    },
    "./multifactor": {
      "types": "./dist/multifactor/index.d.ts",
      "import": "./dist/multifactor/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "test": "vp test run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json && vp test --typecheck --run",
    "docs": "docgen"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "effect": "4.0.0-rc.112"
  },
  "peerDependencies": {
    "effect": ">=4.0.0-rc.112"
  },
  "engines": {
    "node": "^20.19.0 || ^22.18.0 || >=24.11.0"
  }
}
