{
  "name": "effect-auth",
  "version": "1.0.0",
  "description": "An experimental Auth library for Effect.",
  "keywords": [
    "auth",
    "authentication",
    "authorization",
    "effect",
    "session"
  ],
  "homepage": "https://github.com/thomasfosterau/effect-auth#readme",
  "bugs": {
    "url": "https://github.com/thomasfosterau/effect-auth/issues"
  },
  "license": "MIT",
  "author": "",
  "repository": {
    "type": "git",
    "url": "https://github.com/thomasfosterau/effect-auth.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vp test run",
    "typecheck": "tsc --noEmit && vp test --typecheck --run",
    "docs": "docgen"
  },
  "dependencies": {
    "@oslojs/webauthn": "^1.0.0",
    "@node-rs/argon2": "^2.0.2"
  },
  "devDependencies": {
    "@effect/docgen": "^0.5.2",
    "effect": "4.0.0-beta.59",
    "tsx": "^4.19.0"
  },
  "peerDependencies": {
    "effect": ">=4.0.0-beta.59"
  }
}