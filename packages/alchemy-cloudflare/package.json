{
  "name": "@thomasfosterau/effect-auth-alchemy-cloudflare",
  "version": "0.4.0",
  "description": "Cloudflare D1 storage and a deploy-time AuthSchema for effect-auth, built on Alchemy v2's Cloudflare provider.",
  "keywords": [
    "alchemy",
    "auth",
    "authentication",
    "cloudflare",
    "d1",
    "effect",
    "effect-auth",
    "iac",
    "infrastructure",
    "schema",
    "sql",
    "sqlite"
  ],
  "homepage": "https://github.com/thomasfosterau/effect-auth#readme",
  "bugs": {
    "url": "https://github.com/thomasfosterau/effect-auth/issues"
  },
  "license": "MIT",
  "author": "Thomas Foster <me@thomasfoster.au>",
  "repository": {
    "type": "git",
    "url": "https://github.com/thomasfosterau/effect-auth.git",
    "directory": "packages/alchemy-cloudflare"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./AuthSchema": {
      "types": "./dist/AuthSchema.d.ts",
      "import": "./dist/AuthSchema.js"
    },
    "./D1Client": {
      "types": "./dist/D1Client.d.ts",
      "import": "./dist/D1Client.js"
    },
    "./Storage": {
      "types": "./dist/Storage.d.ts",
      "import": "./dist/Storage.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "docs": "docgen"
  },
  "dependencies": {
    "@thomasfosterau/effect-auth": "workspace:^"
  },
  "devDependencies": {
    "@alchemy.run/cloudflare": "catalog:",
    "@effect/docgen": "catalog:",
    "@types/better-sqlite3": "catalog:",
    "@types/node": "catalog:",
    "alchemy": "catalog:",
    "better-sqlite3": "catalog:",
    "effect": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@alchemy.run/cloudflare": "catalog:alchemy-peers",
    "alchemy": "catalog:alchemy-peers",
    "effect": "catalog:alchemy-peers"
  },
  "engines": {
    "node": ">=22"
  }
}
