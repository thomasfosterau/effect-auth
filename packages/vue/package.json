{
  "name": "@thomasfosterau/effect-auth-vue",
  "version": "0.1.0",
  "description": "Vue bindings for the effect-auth client.",
  "keywords": [
    "auth",
    "authentication",
    "client",
    "effect",
    "effect-auth",
    "vue"
  ],
  "homepage": "https://github.com/thomasfosterau/effect-auth#readme",
  "bugs": {
    "url": "https://github.com/thomasfosterau/effect-auth/issues"
  },
  "license": "MIT",
  "author": "Thomas Foster <me@thomasfoster.au>",
  "repository": {
    "type": "git",
    "url": "https://github.com/thomasfosterau/effect-auth.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE.md"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp build && vue-tsc --emitDeclarationOnly",
    "test": "vp test run",
    "typecheck": "vue-tsc --noEmit && vue-tsc --noEmit -p tsconfig.test.json && vp test --typecheck --run"
  },
  "dependencies": {
    "@thomasfosterau/effect-auth-client": "workspace:*"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.5.0",
    "jsdom": "^25.0.1",
    "vue": "^3.5.13",
    "vue-tsc": "^3.3.11"
  },
  "peerDependencies": {
    "vue": ">=3"
  }
}
