{
  "name": "effect-auth-sql",
  "projectType": "library",
  "root": "packages/sql",
  "sourceRoot": "packages/sql/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist"],
      "dependsOn": ["effect-auth:build"],
      "options": {
        "cwd": "packages/sql",
        "command": "vp exec tsc"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": ["effect-auth:build"],
      "options": {
        "cwd": "packages/sql",
        "command": "vp test run"
      },
      "configurations": {
        "watch": {
          "command": "vp test watch"
        }
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "dependsOn": ["effect-auth:build", "typecheck:tests"],
      "options": {
        "cwd": "packages/sql",
        "command": "vp exec tsc --noEmit && vp test --typecheck --run"
      }
    },
    "typecheck:tests": {
      "executor": "nx:run-commands",
      "dependsOn": ["effect-auth:build"],
      "options": {
        "cwd": "packages/sql",
        "command": "vp exec tsc -p tsconfig.test.json --noEmit"
      }
    }
  }
}
