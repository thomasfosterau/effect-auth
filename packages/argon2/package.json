{
  "name": "@thomasfosterau/effect-auth-argon2",
  "version": "0.1.0",
  "description": "Argon2id PasswordHasher for effect-auth — pure WebAssembly by default (Cloudflare Workers safe), with an opt-in native @node-rs/argon2 fast path.",
  "keywords": [
    "argon2",
    "auth",
    "cloudflare-workers",
    "effect",
    "effect-auth",
    "password",
    "wasm",
    "webassembly"
  ],
  "homepage": "https://github.com/thomasfosterau/effect-auth#readme",
  "bugs": {
    "url": "https://github.com/thomasfosterau/effect-auth/issues"
  },
  "license": "MIT",
  "author": "Thomas Foster <me@thomasfoster.au>",
  "repository": {
    "type": "git",
    "url": "https://github.com/thomasfosterau/effect-auth.git",
    "directory": "packages/argon2"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./native": {
      "types": "./dist/Native.d.ts",
      "import": "./dist/Native.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "test": "vp test run",
    "typecheck": "tsc --noEmit && vp test --typecheck --run"
  },
  "dependencies": {
    "@thomasfosterau/effect-auth": "workspace:*",
    "hash-wasm": "^4.12.0"
  },
  "devDependencies": {
    "@node-rs/argon2": "^2.0.2",
    "@types/node": "^26.1.0",
    "effect": ">=4.0.0-beta.93"
  },
  "peerDependencies": {
    "@node-rs/argon2": "^2.0.0",
    "effect": ">=4.0.0-beta.93"
  },
  "peerDependenciesMeta": {
    "@node-rs/argon2": {
      "optional": true
    }
  },
  "engines": {
    "node": "^20.19.0 || ^22.18.0 || >=24.11.0"
  }
}
