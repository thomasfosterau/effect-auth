{
  "name": "@thomasfosterau/effect-auth-argon2",
  "version": "0.4.0",
  "description": "Argon2id PasswordHasher for effect-auth — pure WebAssembly (Cloudflare Workers safe).",
  "keywords": [
    "argon2",
    "auth",
    "cloudflare-workers",
    "effect",
    "effect-auth",
    "password",
    "wasm",
    "webassembly"
  ],
  "homepage": "https://github.com/thomasfosterau/effect-auth#readme",
  "bugs": {
    "url": "https://github.com/thomasfosterau/effect-auth/issues"
  },
  "license": "MIT",
  "author": "Thomas Foster <me@thomasfoster.au>",
  "repository": {
    "type": "git",
    "url": "https://github.com/thomasfosterau/effect-auth.git",
    "directory": "packages/argon2"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./Argon2": {
      "types": "./dist/Argon2.d.ts",
      "import": "./dist/Argon2.js"
    },
    "./Common": {
      "types": "./dist/Common.d.ts",
      "import": "./dist/Common.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "docs": "docgen"
  },
  "dependencies": {
    "@thomasfosterau/effect-auth": "workspace:^"
  },
  "devDependencies": {
    "@effect/docgen": "catalog:",
    "@thomasfosterau/argon2": "catalog:",
    "@types/node": "catalog:",
    "effect": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "workerd": "catalog:"
  },
  "peerDependencies": {
    "effect": "catalog:peers"
  },
  "engines": {
    "node": ">=22"
  }
}
