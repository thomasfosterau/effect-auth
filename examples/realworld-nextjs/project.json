{
  "name": "realworld-nextjs",
  "projectType": "application",
  "root": "examples/realworld-nextjs",
  "sourceRoot": "examples/realworld-nextjs",
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "options": { "cwd": "examples/realworld-nextjs", "command": "bun run dev" }
    },
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["effect-auth:build"],
      "options": { "cwd": "examples/realworld-nextjs", "command": "bun run build" }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "dependsOn": ["effect-auth:build"],
      "options": { "cwd": "examples/realworld-nextjs", "command": "bun run typecheck" }
    }
  }
}
