{
  "name": "realworld-sveltekit",
  "projectType": "application",
  "root": "examples/realworld-sveltekit",
  "sourceRoot": "examples/realworld-sveltekit/src",
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "examples/realworld-sveltekit",
        "command": "bun run dev"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["effect-auth:build"],
      "options": {
        "cwd": "examples/realworld-sveltekit",
        "command": "bun run build"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "dependsOn": ["effect-auth:build"],
      "options": {
        "cwd": "examples/realworld-sveltekit",
        "command": "bun run typecheck"
      }
    }
  }
}
