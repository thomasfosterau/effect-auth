{
  "name": "effect-auth",
  "version": "0.1.0",
  "private": true,
  "description": "An experimental Auth library for Effect.",
  "keywords": [
    "auth",
    "authentication",
    "authorization",
    "effect",
    "session"
  ],
  "homepage": "https://github.com/thomasfosterau/effect-auth#readme",
  "bugs": {
    "url": "https://github.com/thomasfosterau/effect-auth/issues"
  },
  "license": "MIT",
  "author": "Thomas Foster <me@thomasfoster.au>",
  "repository": {
    "type": "git",
    "url": "https://github.com/thomasfosterau/effect-auth.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./email": {
      "types": "./dist/email/index.d.ts",
      "import": "./dist/email/index.js"
    },
    "./http": {
      "types": "./dist/http/index.d.ts",
      "import": "./dist/http/index.js"
    },
    "./oauth": {
      "types": "./dist/oauth/index.d.ts",
      "import": "./dist/oauth/index.js"
    },
    "./session": {
      "types": "./dist/session/index.d.ts",
      "import": "./dist/session/index.js"
    },
    "./password": {
      "types": "./dist/password/index.d.ts",
      "import": "./dist/password/index.js"
    },
    "./plugins": {
      "types": "./dist/plugins/index.d.ts",
      "import": "./dist/plugins/index.js"
    },
    "./authz": {
      "types": "./dist/authz/index.d.ts",
      "import": "./dist/authz/index.js"
    },
    "./secondfactor": {
      "types": "./dist/secondfactor/index.d.ts",
      "import": "./dist/secondfactor/index.js"
    }
  },
  "scripts": {
    "prepare": "vp config && pnpm exec effect-language-service patch",
    "build": "tsc",
    "check": "vp check",
    "test": "vp test run",
    "typecheck": "tsc --noEmit && vp test --typecheck --run",
    "docs": "docgen",
    "changeset": "changeset",
    "release": "changeset publish"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "@oslojs/webauthn": "^1.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@effect/docgen": "^0.5.2",
    "@effect/language-service": "^0.86.4",
    "@types/node": "^26.1.0",
    "effect": ">=4.0.0-beta.93",
    "tsx": "^4.19.0",
    "typescript": "^6.0.3",
    "vite-plus": "^0.2.2"
  },
  "peerDependencies": {
    "effect": ">=4.0.0-beta.93"
  },
  "engines": {
    "node": "^20.19.0 || ^22.18.0 || >=24.11.0"
  },
  "packageManager": "pnpm@11.11.0"
}
