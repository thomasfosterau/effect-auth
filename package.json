{
  "name": "effect-auth",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo for effect-auth, an experimental Auth library for Effect.",
  "homepage": "https://github.com/thomasfosterau/effect-auth#readme",
  "bugs": {
    "url": "https://github.com/thomasfosterau/effect-auth/issues"
  },
  "license": "MIT",
  "author": "Thomas Foster <me@thomasfoster.au>",
  "repository": {
    "type": "git",
    "url": "https://github.com/thomasfosterau/effect-auth.git"
  },
  "type": "module",
  "scripts": {
    "prepare": "vp config --no-agent && effect-tsgo patch --typescript --oxlint",
    "build": "vp run -r build",
    "check": "vp run -r check && vp run check:scripts",
    "docs": "vp run --filter @thomasfosterau/effect-auth docs",
    "check:dist": "tsx scripts/check-dist.ts",
    "check:scripts": "tsc -p tsconfig.scripts.json",
    "fallow": "fallow --summary",
    "fallow:audit": "fallow audit",
    "changeset": "changeset",
    "version": "changeset version && pnpm install --lockfile-only",
    "release": "pnpm -r --filter \"./packages/*\" publish --access public --no-git-checks && changeset tag"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@effect/docgen": "catalog:",
    "@effect/language-service": "catalog:",
    "@effect/tsgo": "catalog:",
    "@mpsuesser/oxlint-plugin-effect": "catalog:",
    "@types/node": "catalog:",
    "@types/semver": "catalog:",
    "@typescript/native": "catalog:",
    "@vitest/coverage-istanbul": "catalog:",
    "effect": "catalog:",
    "effect-solutions": "catalog:",
    "fallow": "catalog:",
    "semver": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": "^20.19.0 || ^22.18.0 || >=24.11.0"
  },
  "packageManager": "pnpm@11.11.0"
}
