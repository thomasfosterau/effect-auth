{
  "name": "effect-auth",
  "version": "1.0.0",
  "description": "An experimental Auth library for Effect.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "ARCHITECTURE.md",
    "SECURITY.md",
    "AGENT_GUIDELINES.md",
    "CONTRIBUTING.md",
    "docs"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && vitest --typecheck --run",
    "prepare": "effect-language-service patch",
    "prepublishOnly": "npm run build && npm run typecheck && npm test",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "npm run build && changeset publish"
  },
  "keywords": [
    "effect",
    "authentication",
    "authorization",
    "auth",
    "session"
  ],
  "author": "",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/thomasfosterau/effect-auth.git"
  },
  "bugs": {
    "url": "https://github.com/thomasfosterau/effect-auth/issues"
  },
  "homepage": "https://github.com/thomasfosterau/effect-auth#readme",
  "dependencies": {
    "@oslojs/webauthn": "^1.0.0",
    "effect": "^3.19.15"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@effect/language-service": "^0.73.0",
    "@effect/vitest": "^0.27.0",
    "@types/node": "^25.2.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "workspaces": [
    "site",
    "packages/*"
  ]
}
