{
  "name": "effect-auth",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo for effect-auth, an experimental Auth library for Effect.",
  "homepage": "https://github.com/thomasfosterau/effect-auth#readme",
  "bugs": {
    "url": "https://github.com/thomasfosterau/effect-auth/issues"
  },
  "license": "MIT",
  "author": "Thomas Foster <me@thomasfoster.au>",
  "repository": {
    "type": "git",
    "url": "https://github.com/thomasfosterau/effect-auth.git"
  },
  "type": "module",
  "scripts": {
    "prepare": "vp config --no-agent && effect-tsgo patch --typescript --oxlint",
    "version": "changeset version && pnpm install --lockfile-only"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@effect/docgen": "catalog:",
    "@effect/language-service": "catalog:",
    "@effect/tsgo": "catalog:",
    "@enfect/oxlint": "catalog:",
    "@types/node": "catalog:",
    "@types/semver": "catalog:",
    "@typescript/native": "catalog:",
    "@vitest/coverage-istanbul": "catalog:",
    "effect": "catalog:",
    "fallow": "catalog:",
    "semver": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "lts"
    }
  },
  "packageManager": "pnpm@12.21.0"
}
