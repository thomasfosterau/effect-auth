{
  "name": "effect-auth",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo for effect-auth, an experimental Auth library for Effect.",
  "homepage": "https://github.com/thomasfosterau/effect-auth#readme",
  "bugs": {
    "url": "https://github.com/thomasfosterau/effect-auth/issues"
  },
  "license": "MIT",
  "author": "Thomas Foster <me@thomasfoster.au>",
  "repository": {
    "type": "git",
    "url": "https://github.com/thomasfosterau/effect-auth.git"
  },
  "type": "module",
  "scripts": {
    "prepare": "vp config && pnpm exec effect-language-service patch",
    "build": "pnpm -r run build",
    "check": "vp check",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck",
    "docs": "pnpm --filter @thomasfosterau/effect-auth run docs",
    "changeset": "changeset",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@effect/docgen": "^0.5.2",
    "@effect/language-service": "^0.87.2",
    "@types/node": "^26.1.0",
    "effect": ">=4.0.0-rc.112",
    "tsx": "^4.19.0",
    "typescript": "^6.0.3",
    "vite-plus": "^0.2.2"
  },
  "engines": {
    "node": "^20.19.0 || ^22.18.0 || >=24.11.0"
  },
  "packageManager": "pnpm@11.11.0"
}
