{
  "name": "effect-auth",
  "version": "1.0.0",
  "description": "An experimental Auth library for Effect.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "packageManager": "bun@1.2.5",
  "engines": {
    "bun": ">=1.2.0"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "ARCHITECTURE.md",
    "SECURITY.md",
    "AGENT_GUIDELINES.md",
    "CONTRIBUTING.md",
    "docs"
  ],
  "scripts": {
    "nx": "nx",
    "build": "nx build effect-auth",
    "test": "nx test effect-auth",
    "test:watch": "nx run effect-auth:test --configuration=watch",
    "typecheck": "nx typecheck effect-auth",
    "prepare": "bunx effect-language-service patch",
    "prepublishOnly": "nx run-many -t build,typecheck,test --projects effect-auth",
    "changeset": "nx changeset effect-auth",
    "version": "nx version effect-auth",
    "release": "nx run effect-auth:build && nx run effect-auth:release",
    "dev:site": "nx dev site",
    "build:site": "nx build site",
    "preview:site": "nx preview site"
  },
  "keywords": [
    "effect",
    "authentication",
    "authorization",
    "auth",
    "session"
  ],
  "author": "",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/thomasfosterau/effect-auth.git"
  },
  "bugs": {
    "url": "https://github.com/thomasfosterau/effect-auth/issues"
  },
  "homepage": "https://github.com/thomasfosterau/effect-auth#readme",
  "dependencies": {
    "@oslojs/webauthn": "^1.0.0",
    "effect": "^3.19.15"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@effect/language-service": "^0.73.0",
    "@effect/vitest": "^0.27.0",
    "@types/node": "^25.2.0",
    "nx": "^22.5.4",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "workspaces": [
    "site",
    "packages/*"
  ]
}