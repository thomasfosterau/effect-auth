{
  "name": "site",
  "projectType": "application",
  "root": "site",
  "sourceRoot": "site/src",
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "site",
        "command": "bun run dev"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/site/dist"],
      "options": {
        "cwd": "site",
        "command": "bun run build"
      }
    },
    "preview": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "site",
        "command": "bun run preview"
      }
    }
  }
}
