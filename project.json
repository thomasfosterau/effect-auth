{
  "name": "effect-auth",
  "projectType": "library",
  "root": ".",
  "sourceRoot": "src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist"],
      "options": {
        "command": "bunx tsc"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bunx vitest run"
      },
      "configurations": {
        "watch": {
          "command": "bunx vitest"
        }
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bunx tsc --noEmit && bunx vitest --typecheck --run"
      }
    },
    "changeset": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bunx changeset"
      }
    },
    "version": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bunx changeset version"
      }
    },
    "release": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bunx changeset publish"
      }
    }
  }
}
